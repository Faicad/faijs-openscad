{
  "name": "@faicad/faijs-openscad-ext",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenSCAD extension library for faijs: hull, polyhedron, twist extrude, projection, surface interpolation, hardened offset — using occt-wasm kernel directly.",
  "license": "AGPL-3.0-only",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@faicad/faijs": "^0.31.1",
    "occt-wasm": "^5.6.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  }
}
